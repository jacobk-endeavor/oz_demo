# Copy to .env and fill in (see https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional — overrides default in generate_transcripts.py and scripts/rebuild_call_metadata_pipeline.py
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional — second model for LLM-as-judge (defaults to OPENROUTER_MODEL)
# OPENROUTER_JUDGE_MODEL=openai/gpt-4o-mini
# Optional — OpenRouter rankings / attribution (https://openrouter.ai/docs)
# OPENROUTER_HTTP_REFERER=https://yoursite.example
# OPENROUTER_APP_NAME=Oz-Demo
# Embedding model for summary cosine similarity (reconstruct heuristics)
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Cosine similarity threshold for llm_summary_semantic_match (0–1)
# OPENROUTER_SUMMARY_SIM_THRESHOLD=0.78
