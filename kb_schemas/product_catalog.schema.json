{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "product_catalog.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["sku", "description", "product_line_code", "product_line", "sub_category"],
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "product_line_code": { "type": "string", "minLength": 1 },
          "product_line": { "type": "string", "minLength": 1 },
          "sub_category": { "type": "string", "minLength": 1 },
          "uom": { "type": "string" },
          "unit_price_avg": { "type": "number" },
          "unit_price_median": { "type": "number" },
          "unit_cost_avg": { "type": "number" },
          "unit_cost_median": { "type": "number" },
          "total_qty_sold": { "type": "number" },
          "total_sales": { "type": "number" },
          "gp_pct_median": { "type": "number" }
        }
      }
    }
  },
  "x-kb-schema": {
    "stem": "product_catalog",
    "version": 1
  }
}
