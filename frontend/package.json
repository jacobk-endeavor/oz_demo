{
  "name": "ecl-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-8080}",
    "build": "tsc --noEmit && vite build",
