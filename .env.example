# Oz + Nebula demo environment variables
# Copy to .env and fill in real values locally.

ELEVENLABS_API_KEY=
# Leave blank to use Eleven Labs default “Rachel” voice. Used for Field App (orb: spoken reply after your request), workflow panels, and scripts.
ELEVENLABS_VOICE_ID=
# Second voice for customer lines in `lumberyard-calls` audio generation (default in script: Rachel)
ELEVENLABS_VOICE_ID_CUSTOMER=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

OPENAI_API_KEY=
# Optional: Brave Search API (https://brave.com/search/api/) for competitor-website type questions in lumberyard Q&A
BRAVE_SEARCH_API_KEY=

ANTHROPIC_API_KEY=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_API_KEY=
REPORT_FROM_EMAIL=
REPORT_TO_EMAILS=

# SMTP — used by the Field App voice flow's "Ok, sending" turn (Script 2 turn 4).
# The Vite middleware at /api/oz/email reads these and sends via Nodemailer.
# Defaults are Google Workspace-compatible (port 465 / SSL). For Gmail/Workspace
# accounts with 2FA, SMTP_PASS must be a 16-char "app password" (not your login).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# "true" for SSL on 465, "false" for STARTTLS on 587. Default: true when port=465.
SMTP_SECURE=true
SMTP_USER=jacob.kalinovskiy@endeavorai.com
SMTP_PASS=
# Defaults to SMTP_USER when blank.
SMTP_FROM=jacob.kalinovskiy@endeavorai.com
# Default recipient when the request body omits `to`. The Field App posts to this.
SMTP_TO_DEFAULT=jacob.kalinovskiy@endeavorai.com

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_REGION=

# The route map is mocked for the demo. No mapping provider keys are required.

VITE_APP_NAME=Oz Nebula Demo

# Demo field rep (Field voice copy, dashboards, mock CRM). Defaults match runbooks if unset.
VITE_DEMO_REP_FIRST_NAME=Sami
VITE_DEMO_REP_LAST_NAME=Torres
